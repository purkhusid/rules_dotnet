load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//dotnet:defs.bzl",
    "publish_binary",
)
load("//dotnet/private/tests/publish:file_modes.bzl", "FILE_MODES", "publish_directory")

[
    publish_binary(
        name = "ready2run_composite" + suffix,
        binary = "//dotnet/private/tests/publish/app_to_publish",
        file_mode = file_mode,
        ready_to_run = True,
        ready_to_run_composite = True,
        self_contained = True,
        target_framework = "net10.0",
    )
    for (suffix, file_mode) in FILE_MODES.items()
]

# We tar the output to because that way we can strip the
# prefix of the files and avoid long path issues on Windows.
# This also makes sure that it's possible to tar the output
# of the publish without any problems
[
    pkg_tar(
        name = "tar" + suffix,
        srcs = [":ready2run_composite" + suffix],
        include_runfiles = True,
        mode = "0755",
        package_dir = "/",
        strip_prefix = publish_directory("ready2run_composite" + suffix),
    )
    for suffix in FILE_MODES
]

[
    sh_test(
        name = "ready2run_composite{}_test".format(suffix),
        srcs = [
            "test.sh",
        ],
        args = ["$(rootpath :tar{})".format(suffix)],
        data = [
            ":tar" + suffix,
            "//dotnet/private/tests/publish:expect_no_symlinks.sh",
        ],
    )
    for suffix in FILE_MODES
]
