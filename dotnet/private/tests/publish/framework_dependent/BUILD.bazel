load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//dotnet:defs.bzl",
    "publish_binary",
)
load("//dotnet/private/tests/publish:file_modes.bzl", "FILE_MODES", "publish_directory")

[
    publish_binary(
        name = "framework_dependent" + suffix,
        binary = "//dotnet/private/tests/publish/app_to_publish",
        file_mode = file_mode,
        roll_forward_behavior = "Major",
        self_contained = False,
        target_framework = "net10.0",
    )
    for (suffix, file_mode) in FILE_MODES.items()
]

# We tar the output to because that way we can strip the
# prefix of the files and avoid long path issues on Windows.
# This also makes sure that it's possible to tar the output
# of the publish without any problems
[
    pkg_tar(
        name = "tar" + suffix,
        srcs = [":framework_dependent" + suffix],
        include_runfiles = True,
        mode = "0755",
        package_dir = "/",
        strip_prefix = publish_directory("framework_dependent" + suffix),
    )
    for suffix in FILE_MODES
]

[
    sh_test(
        name = "framework_dependent{}_test".format(suffix),
        srcs = [
            "test.sh",
        ],
        args = [
            "$(DOTNET_BIN)",
            "$(rootpath :tar{})".format(suffix),
        ],
        data = [
            ":tar" + suffix,
            "//dotnet:resolved_toolchain",
            "//dotnet/private/tests/publish:expect_no_symlinks.sh",
        ],
        toolchains = ["//dotnet:resolved_toolchain"],
    )
    for suffix in FILE_MODES
]

# Run where Bazel leaves the publish, as `bazel run` runs it.
[
    sh_test(
        name = "framework_dependent{}_in_place_test".format(suffix),
        srcs = ["//dotnet/private/tests/publish:run_in_place.sh"],
        args = [
            "$(rootpath :framework_dependent{})".format(suffix),
            "$(DOTNET_BIN)",
        ],
        data = [
            ":framework_dependent" + suffix,
            "//dotnet:resolved_toolchain",
        ],
        toolchains = ["//dotnet:resolved_toolchain"],
    )
    for suffix in FILE_MODES
]
