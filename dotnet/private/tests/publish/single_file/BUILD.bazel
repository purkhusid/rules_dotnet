load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//dotnet:defs.bzl",
    "publish_binary",
)
load("//dotnet/private/tests/publish:file_modes.bzl", "FILE_MODES", "publish_directory")
load(":tests.bzl", "single_file_test_suite")

single_file_test_suite(name = "single_file_test_suite")

[
    publish_binary(
        name = "single_file" + suffix,
        binary = "//dotnet/private/tests/publish/app_to_publish",
        enable_compression_in_single_file = True,
        file_mode = file_mode,
        include_native_libraries_for_self_extract = True,
        self_contained = True,
        single_file = True,
        target_framework = "net10.0",
    )
    for (suffix, file_mode) in FILE_MODES.items()
]

[
    pkg_tar(
        name = "tar" + suffix,
        srcs = [":single_file" + suffix],
        include_runfiles = True,
        mode = "0755",
        package_dir = "/",
        strip_prefix = publish_directory("single_file" + suffix),
    )
    for suffix in FILE_MODES
]

[
    sh_test(
        name = "single_file{}_test".format(suffix),
        srcs = [
            "test.sh",
        ],
        args = ["$(rootpath :tar{})".format(suffix)],
        data = [
            ":tar" + suffix,
            "//dotnet/private/tests/publish:expect_no_symlinks.sh",
        ],
    )
    for suffix in FILE_MODES
]
