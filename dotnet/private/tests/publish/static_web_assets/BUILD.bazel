load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//dotnet:defs.bzl",
    "csharp_binary",
    "publish_binary",
)
load("//dotnet/private/tests/publish:file_modes.bzl", "FILE_MODES", "publish_directory")

# The native link needs a C/C++ toolchain for the target platform, and Windows
# goes through MSVC rather than the Unix driver these rules support.
_NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

csharp_binary(
    name = "app_to_publish",
    srcs = ["Program.cs"],
    project_sdk = "web",
    static_web_assets = glob(["wwwroot/**"]),
    target_frameworks = ["net10.0"],
    deps = ["//dotnet/private/tests/static_web_assets/lib"],
)

[
    publish_binary(
        name = "static_web_assets" + suffix,
        binary = ":app_to_publish",
        file_mode = file_mode,
        self_contained = False,
        target_framework = "net10.0",
    )
    for (suffix, file_mode) in FILE_MODES.items()
]

# Tarred to strip the platform specific prefix, the same way the other publish
# tests do, which also proves the tree survives being packaged.
[
    pkg_tar(
        name = "tar" + suffix,
        srcs = [":static_web_assets" + suffix],
        include_runfiles = True,
        mode = "0755",
        package_dir = "/",
        strip_prefix = publish_directory("static_web_assets" + suffix),
    )
    for suffix in FILE_MODES
]

[
    sh_test(
        name = "static_web_assets{}_test".format(suffix),
        srcs = ["test.sh"],
        args = [
            "$(DOTNET_BIN)",
            "$(rootpath :tar{})".format(suffix),
        ],
        data = [
            ":tar" + suffix,
            "//dotnet:resolved_toolchain",
            "//dotnet/private/tests/publish:expect_no_symlinks.sh",
        ],
        toolchains = ["//dotnet:resolved_toolchain"],
    )
    for suffix in FILE_MODES
]

# A NativeAOT publish keeps nothing managed, so it copies the tree beside the
# executable rather than building the publish layout the rule above goes
# through. Managed-only and free of ASP.NET Core so that ILC can compile it.
csharp_binary(
    name = "aot_app_to_publish",
    srcs = ["AotProgram.cs"],
    static_web_assets = glob(["wwwroot/**"]),
    target_frameworks = ["net10.0"],
    deps = ["//dotnet/private/tests/static_web_assets/lib"],
)

[
    publish_binary(
        name = "native_aot" + suffix,
        binary = ":aot_app_to_publish",
        file_mode = file_mode,
        native_aot = True,
        self_contained = True,
        target_compatible_with = _NOT_WINDOWS,
        target_framework = "net10.0",
    )
    for (suffix, file_mode) in FILE_MODES.items()
]

[
    pkg_tar(
        name = "native_aot_tar" + suffix,
        srcs = [":native_aot" + suffix],
        include_runfiles = True,
        mode = "0755",
        package_dir = "/",
        strip_prefix = publish_directory("native_aot" + suffix, subdirectory = "aot", windows = False),
        target_compatible_with = _NOT_WINDOWS,
    )
    for suffix in FILE_MODES
]

[
    sh_test(
        name = "native_aot{}_test".format(suffix),
        size = "small",
        srcs = ["native_aot_test.sh"],
        args = ["$(rootpath :native_aot_tar{})".format(suffix)],
        data = [
            ":native_aot_tar" + suffix,
            "//dotnet/private/tests/publish:expect_no_symlinks.sh",
        ],
        target_compatible_with = _NOT_WINDOWS,
    )
    for suffix in FILE_MODES
]
