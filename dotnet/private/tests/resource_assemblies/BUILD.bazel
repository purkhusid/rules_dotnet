"Tests for targeting pack conflicts with user provided dependencies."

load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load(
    "//dotnet:defs.bzl",
    "csharp_binary",
    "publish_binary",
)

csharp_binary(
    name = "main",
    srcs = ["Main.cs"],
    target_frameworks = ["net9.0"],
    deps = [
        "@paket.rules_dotnet_nuget_resource_assemblies_tests//humanizer.core",
        "@paket.rules_dotnet_nuget_resource_assemblies_tests//humanizer.core.de",
        "@paket.rules_dotnet_nuget_resource_assemblies_tests//humanizer.core.es",
    ],
)

run_binary(
    name = "run_main",
    outs = ["actual"],
    args = ["$@"],
    tool = ":main",
)

diff_test(
    name = "diff_test_main",
    file1 = ":actual",
    file2 = "expected_output",
)

publish_binary(
    name = "publish_main",
    binary = ":main",
    self_contained = True,
    target_framework = "net9.0",
)

run_binary(
    name = "run_publish_main",
    outs = ["actual_publish"],
    args = ["$@"],
    tool = ":publish_main",
)

diff_test(
    name = "diff_test_publish_main",
    file1 = ":actual_publish",
    file2 = "expected_output",
)

# Left in the runfiles tree, the satellite assemblies are found below the
# runfiles tree beside the executable, where `localPath` points the host of
# .NET 10 and later.
csharp_binary(
    name = "main_net10",
    srcs = ["Main.cs"],
    target_frameworks = ["net10.0"],
    deps = [
        "@paket.rules_dotnet_nuget_resource_assemblies_tests//humanizer.core",
        "@paket.rules_dotnet_nuget_resource_assemblies_tests//humanizer.core.de",
        "@paket.rules_dotnet_nuget_resource_assemblies_tests//humanizer.core.es",
    ],
)

publish_binary(
    name = "publish_main_in_runfiles",
    binary = ":main_net10",
    dependencies_in_runfiles = True,
    self_contained = True,
    target_framework = "net10.0",
)

run_binary(
    name = "run_publish_main_in_runfiles",
    outs = ["actual_publish_in_runfiles"],
    args = ["$@"],
    tool = ":publish_main_in_runfiles",
)

diff_test(
    name = "diff_test_publish_main_in_runfiles",
    file1 = ":actual_publish_in_runfiles",
    file2 = "expected_output",
)

publish_binary(
    name = "publish_main_framework_dependent_in_runfiles",
    binary = ":main_net10",
    dependencies_in_runfiles = True,
    # The toolchain's runtime is newer than the binary's framework.
    roll_forward_behavior = "Major",
    target_framework = "net10.0",
)

# Run on the toolchain's runtime.
genrule(
    name = "run_publish_main_framework_dependent_in_runfiles",
    outs = ["actual_publish_framework_dependent_in_runfiles"],
    cmd = "DOTNET_ROOT=\"$$(pwd)/$$(dirname $(DOTNET_BIN))\" $(execpath :publish_main_framework_dependent_in_runfiles) $@",
    toolchains = ["//dotnet:resolved_toolchain"],
    tools = [
        ":publish_main_framework_dependent_in_runfiles",
        "//dotnet:resolved_toolchain",
    ],
)

diff_test(
    name = "diff_test_publish_main_framework_dependent_in_runfiles",
    file1 = ":actual_publish_framework_dependent_in_runfiles",
    file2 = "expected_output",
)
