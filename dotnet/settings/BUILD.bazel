load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")

# A flag controlling if strict dependencies are enforced or not.
bool_flag(
    name = "strict_deps",
    build_setting_default = True,
    scope = "universal",
    visibility = ["//visibility:public"],
)

# Whether the C# and F# compile actions run in a persistent worker.
# See docs/README.md#persistent-workers.
bool_flag(
    name = "use_compiler_worker",
    build_setting_default = False,
    scope = "universal",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "compiler_worker_enabled",
    flag_values = {":use_compiler_worker": "True"},
    visibility = ["//visibility:public"],
)

# The workers sit behind an alias so that a workspace that leaves them switched
# off never analyses them.
alias(
    name = "csharp_compiler_worker",
    actual = select({
        ":compiler_worker_enabled": "//dotnet/private/tools/csharp_compiler_worker",
        "//conditions:default": ":no_compiler_worker",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "fsharp_compiler_worker",
    actual = select({
        ":compiler_worker_enabled": "//dotnet/private/tools/fsharp_compiler_worker",
        "//conditions:default": ":no_compiler_worker",
    }),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "no_compiler_worker",
    visibility = ["//visibility:public"],
)

# Whether the compilers embed their sources in the PDB.
# See docs/README.md#embedded-sources.
bool_flag(
    name = "embed_all_sources",
    build_setting_default = False,
    scope = "universal",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "embed_all_sources_enabled",
    flag_values = {":embed_all_sources": "True"},
    visibility = ["//visibility:public"],
)

# Whether the C# compiler runs the .NET SDK's built-in analyzers (`CAxxxx`) by
# default. Individual targets can override this with `enable_net_analyzers`.
bool_flag(
    name = "enable_net_analyzers",
    build_setting_default = False,
    scope = "universal",
    visibility = ["//visibility:public"],
)

# Whether the C# compiler runs the .NET SDK's built-in code style analyzers
# (`IDExxxx`) by default. Individual targets can override this with
# `enforce_code_style_in_build`.
bool_flag(
    name = "enforce_code_style_in_build",
    build_setting_default = False,
    scope = "universal",
    visibility = ["//visibility:public"],
)

# Whether every .NET process the rules start runs in globalization-invariant mode.
bool_flag(
    name = "invariant_globalization",
    build_setting_default = False,
    scope = "universal",
    visibility = ["//visibility:public"],
)

label_flag(
    name = "icu",
    build_setting_default = ":system_icu",
    scope = "universal",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "system_icu",
    visibility = ["//visibility:public"],
)

alias(
    name = "hermetic_icu",
    actual = select({
        "@platforms//os:linux": "//dotnet/private/icu",
        "//conditions:default": ":system_icu",
    }),
    visibility = ["//visibility:public"],
)

# How `publish_binary` puts a file into its publish directory and layers.
# See docs/README.md#publish-disk-usage.
#
# * `copy`: every file is copied, so every publish holds its own copy of the
#   runtime pack and every dependency.
# * `hardlink`: files are hard linked where the filesystem allows it, and copied
#   where it does not. The outputs are still regular files.
# * `symlink`: the publish directory holds symlinks Bazel creates. The layers,
#   which packaging rules read as directories, are hard linked.
string_flag(
    name = "publish_file_mode",
    build_setting_default = "copy",
    scope = "universal",
    values = [
        "copy",
        "hardlink",
        "symlink",
    ],
    visibility = ["//visibility:public"],
)
